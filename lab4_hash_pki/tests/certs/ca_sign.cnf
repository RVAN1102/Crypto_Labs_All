[ca]
default_ca = ca_default

[ca_default]
dir = .
database = $dir/index.txt
serial = $dir/ca_serial.txt
new_certs_dir = $dir
certificate = $dir/test_ca.pem
private_key = $dir/test_ca.key
default_md = sha256
policy = policy_any
copy_extensions = copy
unique_subject = no

[policy_any]
commonName = supplied

